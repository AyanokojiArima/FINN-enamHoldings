# FINN configuration. Copy to .env (run.ps1 / run.sh do this for you). Everything is optional.

# Free Gemini key (https://aistudio.google.com/apikey). Switches on transcript reading, bios, verdicts, Ask.
# Without it FINN runs in rules mode and replays AI analyses already in the cache.
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint works instead (Groq, OpenRouter, a local Ollama, ...):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1/
# Pin models; otherwise FINN discovers models and routes by measured speed/quality:
# LLM_MODEL_FAST=
# LLM_MODEL_SMART=
# LLM_MAX_CONCURRENCY=2

# FINN_OFFLINE=1            # serve only from the local cache (no network)
# FINN_REFRESH_SECONDS=900  # background refresh of digest, alerts and pre-warmed cards
# FINN_NO_BACKGROUND=1      # disable the background refresher
# FINN_DATA_DIR=            # where finn.db and downloaded filings live (default backend/data)
